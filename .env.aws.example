# This file documents the production selectors. Keep real secrets in Elastic Beanstalk,
# Secrets Manager, systemd EnvironmentFile entries, or another secret store.
APP_MODE=aws
MOCK_BACKEND=0
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
RUNS_TABLE=agent_runs
AGENT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/QUEUE_NAME
COGNEE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/QUEUE_NAME
DEBUG_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/QUEUE_NAME
CHAT_CONTEXT_BUCKET=replace-with-production-bucket

MODEL_PROVIDER=bedrock
CHAT_MODEL_PROVIDER=bedrock
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_PLANNER_MODEL=replace-with-production-planner-model
BEDROCK_WRITER_MODEL=replace-with-production-writer-model
BEDROCK_CHAT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

COGNEE_ENABLED=1
LLM_PROVIDER=bedrock
LLM_MODEL=replace-with-production-cognee-llm-model
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

AUTH_ENABLED=1
COOKIE_HTTPS_ONLY=1
PUBLIC_BASE_URL=https://cognimoss.com
APP_BASE_URL=https://app.cognimoss.com
SESSION_SECRET=load-from-secret-store
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=replace-me
COGNITO_CLIENT_ID=replace-me
COGNITO_CLIENT_SECRET=load-from-secret-store
COGNITO_DOMAIN=https://replace-me.auth.us-east-1.amazoncognito.com
